# Copy this file to .env and fill in values before starting the stack.
# Never commit .env to version control.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_app

# --- Backend ---
# Async MySQL URL (used by SQLAlchemy + Alembic)
DATABASE_URL=mysql+asyncmy://app_user:change_me_app@mysql:3306/buzzer

# Redis
REDIS_URL=redis://redis:6379/0

# JWT RS256 keys — generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   Then base64-encode each: base64 -w 0 private.pem
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ENCODED_PEM
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ENCODED_PEM

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:8080,http://localhost:8000,http://localhost:5173,http://localhost:5174

# Game limits
MAX_ROOMS=50

# Frontend URL (used in OAuth2 callback redirect)
# In development use port 8080; in production use 443 via Traefik
FRONTEND_URL=http://localhost:8080

# Bootstrap admin account — created automatically on first startup.
# Once an admin user exists these values are ignored and can be removed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin
